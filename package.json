{
  "name": "medicaid-healthcare-dashboard",
  "version": "3.4.0",
  "description": "Multi-role healthcare dashboard with secure authentication",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
